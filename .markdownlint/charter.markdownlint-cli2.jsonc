// Heading shape for the charter. The `md-charter` hook in
// ../.pre-commit-config.yaml owns which documents this applies to.
{
  "config": {
    "MD043": {
      "headings": [
        // The H1 carries the project name.
        "*",
        "## What this is for",
        "## Pillars",
        "## No-gos",
        "## Iteration"
      ]
    }
  }
}
